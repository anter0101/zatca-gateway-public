# Edge
NGINX_PORT=80
PUBLIC_URL=http://localhost

# Postgres
POSTGRES_DB=zatca_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Backend (Nest)
APP_SECRET_KEY=change-me
API_KEY_HASH_SECRET=change-me-api-key-hash-secret
PORT=8080
DATABASE_NAME=zatca_gateway
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_LOGGING=false
DATABASE_SYNCHRONIZE=false
DATABASE_MIGRATIONS_RUN=true
REDIS_HOST=redis
REDIS_PORT=6379
# Isolate compose workers from a host Nest sharing localhost:6379
BULL_PREFIX=bull:docker
SIDECAR_URL=http://sidecar:8090
SIDECAR_MAX_CONCURRENT=8
ZATCA_ENV=simulation
ZATCA_SIMULATION_BASE_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/simulation
ZATCA_DEVELOPER_PORTAL_BASE_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal
ZATCA_PRODUCTION_BASE_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/core

# Frontend (Next) — browser hits nginx, not backend:8080
NEXTAUTH_SECRET=change-me-nextauth
NEXT_PUBLIC_BACKEND_URL=http://localhost
NEXT_PUBLIC_APP_URL=http://localhost

# Sidecar (Java + SDK)
SIDECAR_PORT=8090
FATOORA_HOME=/opt/zatca-sdk
