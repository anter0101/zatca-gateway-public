{
  "info": {
    "_postman_id": "a1b2c3d4-zatca-gateway-phase2-3",
    "name": "ZATCA Gateway",
    "description": "Admin JWT APIs (Phase 2) + vendor sk_* onboard APIs (Phase 3).\n\n**Flow**\n1. Auth → Login (saves `admin_token`)\n2. Vendors → Create (saves `vendor_id`)\n3. API Keys → Generate (saves `api_key` once)\n4. Tax Payers → Create (saves `tax_payer_id`)\n5. Onboard → Create CSR with `api_key`, then Start Onboard with OTP from Fatoora portal\n\nError envelope: `{ \"error\": { \"type\", \"code\", \"message\", \"zatca_code\" } }`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.token) pm.environment.set('admin_token', body.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/login",
            "description": "Returns JWT for ADMIN routes. Saves `admin_token` to the environment."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@admin.com\",\n  \"password\": \"12345\"\n}"
                },
                "url": "{{base_url}}/api/auth/login"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"user\": {\n    \"id\": 1,\n    \"email\": \"admin@admin.com\",\n    \"username\": \"Administrator\",\n    \"role\": \"ADMIN\",\n    \"activated\": true\n  },\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n}"
            },
            {
              "name": "400 validation",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{}" },
                "url": "{{base_url}}/api/auth/login"
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": {\n    \"type\": \"invalid_request\",\n    \"code\": \"validation_error\",\n    \"message\": \"email should not be empty\",\n    \"zatca_code\": null\n  }\n}"
            }
          ]
        }
      ]
    },
