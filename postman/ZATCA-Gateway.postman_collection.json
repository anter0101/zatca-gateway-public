    {
      "name": "5. Onboard /v1 (sk_* or ADMIN JWT)",
      "description": "Use `Authorization: Bearer {{api_key}}` (`sk_test_` / `sk_live_`). Admin JWT also works. Test keys → simulation only.",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{api_key}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Create CSR",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{base_url}}/v1/taxpayers/{{tax_payer_id}}/onboard/csr",
