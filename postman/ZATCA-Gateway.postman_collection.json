    {
      "name": "3. API Keys (ADMIN)",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Generate API key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.id) pm.environment.set('api_key_id', String(body.id));",
                  "  if (body.key) pm.environment.set('api_key', body.key);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prefix\": \"sk_test_\",\n  \"expiresInDays\": 90\n}"
            },
            "url": "{{base_url}}/api/vendors/{{vendor_id}}/api-keys",
            "description": "Plaintext `key` returned **once**. Store it. Alternative body: `{ \"prefix\": \"sk_live_\", \"expiresAt\": \"2027-01-01T00:00:00.000Z\" }`."
          },
          "response": [
            {
              "name": "201 Created (key shown once)",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"prefix\": \"sk_test_\",\n  \"expiresInDays\": 90\n}"
                },
                "url": "{{base_url}}/api/vendors/1/api-keys"
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"id\": 10,\n  \"key\": \"sk_test_a1b2c3d4e5f6fullSecretShownOnce\",\n  \"prefix\": \"sk_test_\",\n  \"last4\": \"Once\",\n  \"expiresAt\": \"2026-12-20T12:00:00.000Z\",\n  \"lastUsedAt\": null,\n  \"revokedAt\": null,\n  \"expired\": false,\n  \"createdAt\": \"2026-09-21T12:00:00.000Z\"\n}"
